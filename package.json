{
  "name": "aevrix-video-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@10.9.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev --workspace @aevrix/web",
    "dev:api": "npm run dev --workspace @aevrix/api",
    "build": "npm run build --workspace @aevrix/shared-types && npm run build --workspace @aevrix/api && npm run build --workspace @aevrix/web",
    "validate:models": "node scripts/validate-models.mjs",
    "test:replicate": "node scripts/test-replicate.mjs",
    "start": "concurrently -n api,web \"npm run start --workspace @aevrix/api\" \"npm run start --workspace @aevrix/web\"",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @aevrix/web",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "setup": "node scripts/setup.mjs",
    "prisma": "npm run prisma --workspace @aevrix/api --",
    "db:migrate": "npm run db:migrate --workspace @aevrix/api",
    "db:studio": "npm run db:studio --workspace @aevrix/api",
    "mock:fixture": "powershell -ExecutionPolicy Bypass -File scripts/generate-mock-fixture.ps1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
